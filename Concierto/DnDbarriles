package com.mycompany.dndbarriles;

import java.util.Scanner;

public class DnDbarriles {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.println("==========================================");
        System.out.println("          BIENVENIDO a la campaña de DnD:"
                + "La comunidad del barril en busca de la caguama suprema\n");
        System.out.println("==========================================");
        System.out.println("1. Iniciar Partida");
        System.out.println("2. Salir");

        if (scanner.nextInt() == 1) {
            System.out.println("\n--- SELECCIÓN DE PERSONAJE ---");
            System.out.println("1. Druida (Demet In Vraan)");
            System.out.println("2. Paladín (Noel Dandelion)");
            System.out.println("3. Enano Artificiero (Knull Boca de Dragón)");
            System.out.println("4. Gata");

            int opc = scanner.nextInt();
            Heroe jugador = null;

            if (opc == 1) jugador = new Druida();
            else if (opc == 2) jugador = new PaladinGoliath();
            else if (opc == 3) jugador = new EnanoArtificiero();
            else if (opc == 4) jugador = new Gato();
            else jugador = new PaladinGoliath(); // Default

            Partida capitulo1 = new Partida(jugador);
            capitulo1.iniciarHistoria();

        } else {
            System.out.println("Saliendo del juego...");
        }
        scanner.close();
    }
}
