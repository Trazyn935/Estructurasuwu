package com.mycompany.dndbarriles;

import java.util.Random;
import java.util.Scanner; // <-- Agregada la importación de Scanner

/**
 *
 * @author fravi
 */
public class Druida extends Heroe {

    /*String nombre;
    int hpMaximo;
    int hpActual;*/
    int claseArmadura;
    int bonificadorDestreza;
    int bonificadorSabiduria;
    int bonificadorAtaque;
    int espaciosConjuro;
    Random dado;
    //int filaActual;
    //int columnaActual;

    public Druida() {
        this.nombre = "Demet In Vraan";
        this.hpMaximo = 8; 
        this.hpActual = 8;
        this.claseArmadura = 15; 
        this.bonificadorDestreza = 4; 
        this.bonificadorSabiduria = 4; 
        this.bonificadorAtaque = 6; 
        this.espaciosConjuro = 2; 
        this.dado = new Random();
        this.filaActual = 0;
        this.columnaActual = 0;
    }

    @Override
    public void mover(int nuevaFila, int nuevaColumna) {
        this.filaActual = nuevaFila;
        this.columnaActual = nuevaColumna;
        System.out.println("\n" + this.nombre + " avanza sigilosamente hacia las coordenadas [" + this.filaActual + "][" + this.columnaActual + "] del mapa.");
    }

    @Override
    public void ejecutarTurnoCombate(Guardia enemigo, Scanner scanner) {
        System.out.println("\n--- TURNO DE " + this.nombre.toUpperCase() + " ---");
        System.out.println("1. Atacar con Arco Largo");
        System.out.println("2. Atacar con Daga");
        System.out.println("3. Conjurar Palabra Curativa");
        int opc = scanner.nextInt();

        if (opc == 1) {
            atacarConArcoLargo(enemigo);
        } else if (opc == 2) {
            atacarConDaga(enemigo);
        } else if (opc == 3) {
            conjurarPalabraCurativa();
        } else {
            atacarConArcoLargo(enemigo);
        }
    }

    public int tirarIniciativa() {
        return dado.nextInt(20) + 1 + bonificadorDestreza;
    }

    public void atacarConArcoLargo(Guardia enemigo) { // <-- Ahora recibe al Guardia directamente
        int tiradaD20 = dado.nextInt(20) + 1;
        int totalAtaque = tiradaD20 + bonificadorAtaque;

        System.out.println("\n" + this.nombre + " tensa su Arco Largo y dispara a " + enemigo.nombre + ".");
        System.out.println("Tirada de ataque: " + tiradaD20 + " + " + bonificadorAtaque + " = " + totalAtaque);

        if (tiradaD20 == 20) {
            int danoCritico = (dado.nextInt(8) + 1) + (dado.nextInt(8) + 1) + bonificadorDestreza;
            System.out.print("¡GOLPE CRÍTICO! La flecha impacta vitalmente.");
            enemigo.recibirDano(danoCritico); // <-- Aplica el daño real
        } else if (totalAtaque >= enemigo.claseArmadura) {
            int dano = (dado.nextInt(8) + 1) + bonificadorDestreza;
            System.out.print("¡Impacto! La flecha alcanza a " + enemigo.nombre + ".");
            enemigo.recibirDano(dano); // <-- Aplica el daño real
        } else {
            System.out.println("La flecha pasa de largo sin hacer daño a " + enemigo.nombre + ".");
        }
    }

    public void atacarConDaga(Guardia enemigo) { // <-- Ahora recibe al Guardia directamente
        int tiradaD20 = dado.nextInt(20) + 1;
        int totalAtaque = tiradaD20 + bonificadorAtaque;

        System.out.println("\n" + this.nombre + " ataca cuerpo a cuerpo a " + enemigo.nombre + " con su Daga.");
        System.out.println("Tirada de ataque: " + tiradaD20 + " + " + bonificadorAtaque + " = " + totalAtaque);

        if (tiradaD20 == 20) {
            int danoCritico = (dado.nextInt(4) + 1) + (dado.nextInt(4) + 1) + bonificadorDestreza;
            System.out.print("¡GOLPE CRÍTICO!");
            enemigo.recibirDano(danoCritico); // <-- Aplica el daño real
        } else if (totalAtaque >= enemigo.claseArmadura) {
            int dano = (dado.nextInt(4) + 1) + bonificadorDestreza;
            System.out.print("¡Impacto!");
            enemigo.recibirDano(dano); // <-- Aplica el daño real
        } else {
            System.out.println("El ataque con la daga es evadido por " + enemigo.nombre + ".");
        }
    }

    public void conjurarPalabraCurativa() {
        if (espaciosConjuro > 0) {
            int curacion = dado.nextInt(4) + 1 + bonificadorSabiduria; 
            this.hpActual += curacion;
            
            if (this.hpActual > this.hpMaximo) {
                this.hpActual = this.hpMaximo;
            }
            
            this.espaciosConjuro--;
            System.out.println("\n" + this.nombre + " murmura una Palabra Curativa (magia de Druida).");
            System.out.println("Recupera " + curacion + " HP. HP actual: " + this.hpActual + "/" + this.hpMaximo);
            System.out.println("Espacios de conjuro restantes: " + this.espaciosConjuro);
        } else {
            System.out.println("\n" + this.nombre + " no tiene suficientes espacios de conjuro para sanar.");
        }
    }
}
