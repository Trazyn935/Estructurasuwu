package com.mycompany.dndbarriles;

import java.util.Random;
import java.util.Scanner; // <-- Agregada importación

/**
 *
 * @author fravi
 */
public class EnanoArtificiero extends Heroe {

    /*String nombre;
    int hpMaximo;
    int hpActual;*/
    int claseArmadura;
    int bonificadorFuerza;
    int bonificadorDestreza;
    int bonificadorInteligencia;
    int bonificadorAtaqueCuerpoACuerpo;
    int bonificadorAtaqueDistancia;
    int espaciosConjuro;
    Random dado;
    //int filaActual;
    //int columnaActual;

    public EnanoArtificiero() {
        this.nombre = "Knull Boca de Dragón";
        this.hpMaximo = 13;
        this.hpActual = 13;
        this.claseArmadura = 18;
        this.bonificadorFuerza = 5;
        this.bonificadorDestreza = 2;
        this.bonificadorInteligencia = 4;
        this.bonificadorAtaqueCuerpoACuerpo = 7; 
        this.bonificadorAtaqueDistancia = 4; 
        this.espaciosConjuro = 2;
        this.dado = new Random();
        this.filaActual = 0;
        this.columnaActual = 0;
    }

    @Override
    public void mover(int nuevaFila, int nuevaColumna) {
        this.filaActual = nuevaFila;
        this.columnaActual = nuevaColumna;
        System.out.println("\n" + this.nombre + " avanza hacia las coordenadas [" + this.filaActual + "][" + this.columnaActual + "] del mapa.");
    }

    @Override
    public void ejecutarTurnoCombate(Guardia enemigo, Scanner scanner) {
        System.out.println("\n--- TURNO DE " + this.nombre.toUpperCase() + " ---");
        System.out.println("1. Atacar con Martillo de Guerra");
        System.out.println("2. Disparar Cañón Largo");
        System.out.println("3. Disparar Bala Especial");
        System.out.println("4. Conjurar Sanar");
        int opc = scanner.nextInt();

        if (opc == 1) {
            atacarConMartillo(enemigo);
        } else if (opc == 2) {
            dispararCanon(enemigo);
        } else if (opc == 3) {
            dispararBalaEspecial(enemigo);
        } else if (opc == 4) {
            conjurarSanar();
        } else {
            atacarConMartillo(enemigo);
        }
    }

    public int tirarIniciativa() {
        return dado.nextInt(20) + 1 + bonificadorDestreza;
    }

    public void atacarConMartillo(Guardia enemigo) {
        int tiradaD20 = dado.nextInt(20) + 1;
        int totalAtaque = tiradaD20 + bonificadorAtaqueCuerpoACuerpo;

        System.out.println("\n" + this.nombre + " ataca a " + enemigo.nombre + " con su Martillo de guerra.");
        System.out.println("Tirada de ataque: " + tiradaD20 + " + " + bonificadorAtaqueCuerpoACuerpo + " = " + totalAtaque);

        if (tiradaD20 == 20) {
            int danoCritico = (dado.nextInt(10) + 1) + (dado.nextInt(10) + 1) + bonificadorFuerza + 1;
            System.out.print("¡GOLPE CRÍTICO!");
            enemigo.recibirDano(danoCritico);
        } else if (totalAtaque >= enemigo.claseArmadura) {
            int dano = (dado.nextInt(10) + 1) + bonificadorFuerza + 1;
            System.out.print("¡Impacto!");
            enemigo.recibirDano(dano);
        } else {
            System.out.println("El ataque falló contra la armadura de " + enemigo.nombre + ".");
        }
    }

    public void dispararCanon(Guardia enemigo) {
        int tiradaD20 = dado.nextInt(20) + 1;
        int totalAtaque = tiradaD20 + bonificadorAtaqueDistancia;

        System.out.println("\n" + this.nombre + " dispara a " + enemigo.nombre + " con su Cañón largo.");
        System.out.println("Tirada de ataque: " + tiradaD20 + " + " + bonificadorAtaqueDistancia + " = " + totalAtaque);

        if (tiradaD20 == 20) {
            int danoCritico = (dado.nextInt(12) + 1) + (dado.nextInt(12) + 1) + bonificadorDestreza + 1;
            System.out.print("¡GOLPE CRÍTICO!");
            enemigo.recibirDano(danoCritico);
        } else if (totalAtaque >= enemigo.claseArmadura) {
            int dano = (dado.nextInt(12) + 1) + bonificadorDestreza + 1;
            System.out.print("¡Impacto!");
            enemigo.recibirDano(dano);
        } else {
            System.out.println("El disparo rebotó en la armadura de " + enemigo.nombre + ".");
        }
    }

    public void dispararBalaEspecial(Guardia enemigo) {
        int bonificadorAtaqueMagico = bonificadorInteligencia + 2; 
        int tiradaD20 = dado.nextInt(20) + 1;
        int totalAtaque = tiradaD20 + bonificadorAtaqueMagico;

        System.out.println("\n" + this.nombre + " usa su Ataque Especial (Bala Especial) contra " + enemigo.nombre + ".");
        System.out.println("Tirada de ataque: " + tiradaD20 + " + " + bonificadorAtaqueMagico + " = " + totalAtaque);

        if (tiradaD20 == 20) {
            int danoCritico = (dado.nextInt(12) + 1) + (dado.nextInt(12) + 1) + bonificadorInteligencia + 2;
            System.out.print("¡GOLPE CRÍTICO MAGISTRAL!");
            enemigo.recibirDano(danoCritico);
        } else if (totalAtaque >= enemigo.claseArmadura) {
            int dano = (dado.nextInt(12) + 1) + bonificadorInteligencia + 2;
            System.out.print("¡Impacto!");
            enemigo.recibirDano(dano);
        } else {
            System.out.println("La bala especial no logró penetrar la defensa de " + enemigo.nombre + ".");
        }
    }

    public void conjurarSanar() {
        if (espaciosConjuro > 0) {
            int curacion = dado.nextInt(8) + 1 + bonificadorInteligencia + 2; 
            this.hpActual += curacion;
            
            if (this.hpActual > this.hpMaximo) {
                this.hpActual = this.hpMaximo;
            }
            
            this.espaciosConjuro--;
            System.out.println("\n" + this.nombre + " usa su conjuro Sanar.");
            System.out.println("Recupera " + curacion + " HP. HP actual: " + this.hpActual + "/" + this.hpMaximo);
            System.out.println("Espacios de conjuro restantes: " + this.espaciosConjuro);
        } else {
            System.out.println("\n" + this.nombre + " no tiene suficientes espacios de conjuro para Sanar.");
        }
    }
}
